# Copy to .env and adjust.

APP_NAME=HRMS
ENVIRONMENT=development
DEBUG=true

# SQLite (zero-setup dev default):
DATABASE_URL=sqlite:///./hrms.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+psycopg2://hrms:hrms@localhost:5432/hrms

# CHANGE THIS IN PRODUCTION
SECRET_KEY=dev-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# Auto-create tables on startup (dev only; use Alembic in production)
AUTO_CREATE_TABLES=true

# Skip email verification requirement at login (no mailer wired in MVP-1)
REQUIRE_EMAIL_VERIFICATION=false
